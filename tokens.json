  "semantic": {
    "color": {
      "light": {
        "textPrimary": {
          "$type": "color",
          "$value": "#241b45",
          "$description": "Semantic textPrimary for the light theme."
        },
        "textSecondary": {
          "$type": "color",
          "$value": "#3b2f63",
          "$description": "Semantic textSecondary for the light theme."
        },
        "textMuted": {
          "$type": "color",
          "$value": "#4f4874",
          "$description": "Semantic textMuted for the light theme."
        },
        "stateSuccess": {
          "$type": "color",
          "$value": "#0f7a55",
          "$description": "Semantic stateSuccess for the light theme."
        },
        "stateWarning": {
          "$type": "color",
          "$value": "#8a5a12",
          "$description": "Semantic stateWarning for the light theme."
        },
        "stateError": {
