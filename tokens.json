        },
        "focusRing": {
          "$type": "color",
          "$value": "#4b3b8f",
          "$description": "Semantic focusRing for the light theme."
        },
        "controlInk": {
          "$type": "color",
          "$value": "#4b3b8f",
          "$description": "Semantic controlInk for the light theme."
        },
        "controlBorder": {
          "$type": "color",
          "$value": "#ffffff",
          "$description": "Semantic controlBorder for the light theme."
        },
        "pillInk": {
          "$type": "color",
          "$value": "#4f4874",
          "$description": "Semantic pillInk for the light theme."
        },
        "pillBorder": {
          "$type": "color",
          "$value": "#cbb8ff",
          "$description": "Semantic pillBorder for the light theme."
        },
        "cardGradient": {
          "$type": "gradient",
          "$value": "linear-gradient(160deg, rgba(238,232,255,0.95) 0%, rgba(226,217,255,0.92) 30%, rgba(240,235,255,0.9) 58%, rgba(214,204,250,0.94) 100%)",
          "$description": "Base card surface gradient for the light theme."
        },
        "cardShadow": {
          "$type": "shadow",
          "$value": "0 28px 58px -26px rgba(50,25,100,0.6), 0 12px 26px -18px rgba(50,25,100,0.4), 0 0 0 3px rgba(255,240,200,0.35), 0 0 22px rgba(226,185,105,0.25), inset 0 1px 0 rgba(255,255,255,0.9)",
          "$description": "Base card elevation shadow for the light theme."
        },
        "sparkleWarm": {
          "$type": "color",
          "$value": "#d9ae5c",
          "$description": "Warm star sparkle accent (gold), decorative only."
        }
      }
    },
    "space": {
      "component-card-padding": {
        "comfortable": "12px",
        "compact": "8px",
        "$type": "dimension"
      },
      "component-panel-padding-x": {
        "comfortable": "8px",
        "compact": "8px",
        "$type": "dimension"
      },
      "component-panel-padding-y": {
        "comfortable": "8px",
        "compact": "4px",
        "$type": "dimension"
      },
      "component-row-gap": {
        "comfortable": "8px",
        "compact": "4px",
        "$type": "dimension"
      },
      "component-section-gap": {
        "comfortable": "12px",
        "compact": "8px",
        "$type": "dimension"
      },
      "component-credit-gap": {
        "comfortable": "8px",
        "compact": "4px",
        "$type": "dimension"
      },
      "layout-edge": {
        "$type": "dimension",
        "$value": "16px"
      },
      "layout-lifted-edge": {
        "$type": "dimension",
        "$value": "96px"
      },
      "layout-card-width": {
        "$type": "dimension",
        "$value": "310px",
        "$description": "Card width; clamped to the viewport by the layout."
      }
    },
    "type": {
      "title": {
        "$type": "typography",
        "fontSize": "16px",
        "lineHeight": "20px",
        "fontWeight": 800,
        "letterSpacing": "-0.012em"
      },
      "value": {
        "$type": "typography",
        "fontSize": "14.25px",
        "lineHeight": "16px",
        "fontWeight": 800,
        "letterSpacing": "-0.015em"
      },
      "body": {
        "$type": "typography",
        "fontSize": "12.65px",
        "lineHeight": "16px",
        "fontWeight": 750,
        "letterSpacing": "0.005em"
      },
      "bodySmall": {
        "$type": "typography",
        "fontSize": "11.25px",
        "lineHeight": "16px",
        "fontWeight": 600,
        "letterSpacing": "0.01em"
      },
      "label": {
        "$type": "typography",
        "fontSize": "10px",
        "lineHeight": "12px",
        "fontWeight": 750,
        "letterSpacing": "0.06em"
      },
      "caption": {
        "$type": "typography",
        "fontSize": "10px",
        "lineHeight": "12px",
        "fontWeight": 600,
        "letterSpacing": "0.01em"
      },
      "credit": {
        "$type": "typography",
        "fontSize": "10px",
        "lineHeight": "12px",
        "fontWeight": 500,
        "letterSpacing": "0.005em"
      },
      "badge": {
        "$type": "typography",
        "fontSize": "10px",
        "lineHeight": "12px",
        "fontWeight": 750,
        "letterSpacing": "0.08em"
      },
      "display": {
        "$type": "typography",
        "fontSize": "18px",
        "lineHeight": "20px",
        "fontWeight": 800,
        "letterSpacing": "-0.02em"
      },
      "pill": {
        "$type": "typography",
        "fontSize": "12px",
        "lineHeight": "16px",
        "fontWeight": 650,
        "letterSpacing": "0.01em"
      }
    }
  },
  "component": {
    "quotaBubble": {
      "base": {
        "radius": {
          "$type": "dimension",
          "$value": "{primitive.radius.card}",
          "$description": "Shared base card radius; any future card variant must use it."
        },
        "padding": {
          "$type": "dimension",
          "$value": "{semantic.space.component-card-padding}",
          "$description": "Shared base card padding (density-aware)."
        },
        "surface": {
          "$type": "gradient",
          "$value": "{semantic.color.light.cardGradient}",
          "$description": "Base card surface gradient (light theme; the card is light-only)."
        },
        "shadow": {
          "$type": "shadow",
          "$value": "{semantic.color.light.cardShadow}",
          "$description": "Base card elevation (light theme; the card is light-only)."
        }
      },
      "card": {
        "padding": {
          "$type": "dimension",
          "$value": "{semantic.space.component-card-padding}"
        },
        "radius": {
          "$type": "dimension",
          "$value": "{primitive.radius.card}"
        },
        "gap": {
          "$type": "dimension",
          "$value": "{primitive.space.3}"
        }
      },
      "legend": {
        "mark": {
          "$type": "dimension",
          "$value": "{primitive.size.legend-mark}"
        },
        "plate-padding": {
          "$type": "dimension",
          "$value": "{primitive.size.hairline}"
        }
      },
      "panel": {
        "padding-x": {
          "$value": "{semantic.space.component-panel-padding-x}"
        },
        "padding-y": {
          "$value": "{semantic.space.component-panel-padding-y}"
        },
        "radius": {
          "$value": "{primitive.radius.panel}"
        }
      },
      "meter": {
        "radius": {
          "$value": "{primitive.radius.meter}"
        },
        "bar-height": {
          "$value": "{primitive.size.bar-height}"
        },
        "gap": {
          "$value": "{semantic.space.component-row-gap}"
        },
        "label-size": {
          "$type": "dimension",
          "$value": "12px",
          "$description": "Meter section label size (component override of the label role)."
        },
        "label-line-height": {
          "$type": "dimension",
          "$value": "16px",
          "$description": "Meter section label line height, aligned to the 4px baseline grid."
        }
      },
      "footer": {
        "mark": {
          "$value": "{primitive.size.footer-mark}"
        },
        "section-gap": {
          "$value": "{semantic.space.component-section-gap}"
        }
      },
      "credit": {
        "gap": {
          "$value": "{semantic.space.component-credit-gap}"
        }
      },
      "control": {
        "size": {
          "$value": "{primitive.size.control}"
        },
        "radius": {
          "$value": "{primitive.radius.control}"
        }
      },
      "pill": {
        "height": {
          "$value": "{primitive.size.pill-height}"
        },
        "padding-x": {
          "$value": "{primitive.space.4}"
        },
        "padding-left": {
          "$value": "{primitive.space.3}"
        }
      }
    }
  }
}
